{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-commit-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
